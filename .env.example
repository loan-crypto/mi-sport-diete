# Copia este archivo a .env.local (nunca se sube a git) y completa con
# los valores de tu proyecto Supabase (Project Settings > API).
# Son claves PUBLICAS pensadas para el navegador: la seguridad real la
# dan las politicas RLS de cada tabla, no el secreto de esta clave.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY
